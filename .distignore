# Files and folders that never reach the live site.
# Used by .github/workflows/deploy.yml (the `deploy` branch Deployer for Git
# installs) and release.yml (the release zip). Everything else ships:
# assets/, build/, inc/, parts/, patterns/, templates/, functions.php,
# style.css, theme.json and screenshot.png.

# Source and tooling
/src
/node_modules
/vendor
/tests
/docs
/scripts
/.git
/.github
/.vscode
/.idea
/.claude
/.commandcode
/.wordpress-org

# Package and build config
package.json
package-lock.json
composer.json
composer.lock
webpack.config.js
Gruntfile.js
gulpfile.js
*.config.js
*.config.json
phpunit.xml
phpcs.xml
.phpcs.xml
.editorconfig
.eslintrc*
.prettierrc*
.stylelintrc*
.babelrc*
.nvmrc
.npmrc
.gitignore
.gitattributes
.distignore
.env*

# Docs, notes and AI instructions (CLAUDE.md, AGENTS.md, README.md…)
*.md
*.txt

# Build leftovers and junk
*.map
*.LICENSE.txt
*.log
*.lock
*.zip
.DS_Store
