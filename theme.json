    "styles": {
        "blocks": {
            "core/avatar": {
                "border": {
                    "radius": "100px"
                }
            },
            "core/button": {
                "variations": {
                    "link": {
                        "border": {
                            "bottom": {
                                "color": "currentColor",
                                "style": "solid",
                                "width": "1px"
                            },
                            "color": "transparent",
                            "radius": "0px",
                            "style": "none",
                            "width": "0"
                        },
                        ":hover": {
                            "color": {
                                "text": "var(--wp--preset--color--bnti-green-pea)"
                            }
                        },
                        "color": {
                            "background": "transparent",
                            "text": "#538988"
                        },
                        "css": "background: transparent !important;",
                        "spacing": {
                            "padding": {
                                "bottom": "0",
                                "left": "0",
                                "right": "0",
                                "top": "0"
                            }
                        },
                        "typography": {
                            "textDecoration": "none"
                        }
                    },
                    "alternative": {
                        "border": {
                            "radius": "4px"
                        },
                        "color": {
                            "background": "var(--wp--preset--color--bnti-goblin-lightest)",
                            "text": "var(--wp--preset--color--bnti-green-pea)"
                        },
                        "spacing": {
                            "padding": {
                                "bottom": "4px",
                                "left": "28px",
                                "right": "28px",
                                "top": "4px"
                            }
                        },
                        ":hover": {
                            "color": {
                                "background": "var(--wp--preset--color--bnti-goblin)",
                                "text": "var(--wp--preset--color--bnti-white)"
                            }
                        }
                    },
                    "outline": {
                        "border": {
                            "color": "currentColor",
                            "radius": "0px",
                            "style": "solid",
                            "width": "1px"
                        },
                        "color": {
                            "background": "transparent",
                            "text": "var(--wp--preset--color--bnti-white)"
                        },
                        "spacing": {
                            "padding": {
                                "top": "15px",
                                "right": "27px",
                                "bottom": "15px",
                                "left": "27px"
                            }
                        },
                        ":hover": {
                            "color": {
                                "background": "transparent",
                                "text": "var(--wp--preset--color--bnti-goblin)"
                            }
                        }
                    }
                }
            },
            "core/buttons": {
                "spacing": {
                    "blockGap": "16px"
                }
            },
            "core/code": {
                "color": {
                    "background": "var(--wp--preset--color--bnti-neutral-lightest)",
                    "text": "var(--wp--preset--color--bnti-neutral-darkest)"
                },
                "spacing": {
                    "padding": {
                        "bottom": "var(--wp--preset--spacing--bnti-40)",
                        "left": "var(--wp--preset--spacing--bnti-40)",
                        "right": "var(--wp--preset--spacing--bnti-40)",
                        "top": "var(--wp--preset--spacing--bnti-40)"
                    }
                },
                "typography": {
                    "fontFamily": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace",
                    "fontSize": "var(--wp--preset--font-size--bnti-regular)",
                    "fontWeight": "300"
                }
            },
            "core/columns": {
                "spacing": {
                    "blockGap": "var(--wp--preset--spacing--bnti-50)"
                }
            },
            "core/comment-author-name": {
                "color": {
                    "text": "var(--wp--preset--color--bnti-white)"
                },
                "elements": {
                    "link": {
                        ":hover": {
                            "typography": {
                                "textDecoration": "underline"
                            }
                        },
                        "color": {
                            "text": "var(--wp--preset--color--bnti-white)"
                        },
                        "typography": {
                            "textDecoration": "none"
                        }
                    }
                },
                "spacing": {
                    "margin": {
                        "bottom": "0px",
                        "top": "5px"
                    }
                },
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--bnti-small)"
                }
            },
            "core/comment-content": {
                "spacing": {
                    "margin": {
                        "bottom": "var(--wp--preset--spacing--bnti-30)",
                        "top": "var(--wp--preset--spacing--bnti-30)"
                    }
                },
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--bnti-regular)"
                }
            },
            "core/comment-date": {
