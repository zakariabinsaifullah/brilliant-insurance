    "styles": {
        "blocks": {
            "core/avatar": {
                "border": {
                    "radius": "100px"
                }
            },
            "core/button": {
                "variations": {
                    "link": {
                        "border": {
                            "bottom": {
                                "color": "currentColor",
                                "style": "solid",
                                "width": "1px"
                            },
                            "color": "transparent",
                            "radius": "0px",
                            "style": "none",
                            "width": "0"
                        },
                        ":hover": {
                            "color": {
                                "text": "var(--wp--preset--color--bnti-premier-dark)"
                            }
                        },
                        "color": {
                            "background": "transparent",
                            "text": "var(--wp--preset--color--bnti-premier)"
                        },
                        "css": "background: transparent !important;",
                        "spacing": {
                            "padding": {
                                "bottom": "0",
                                "left": "0",
                                "right": "0",
                                "top": "0"
                            }
                        },
                        "typography": {
                            "textDecoration": "none"
                        }
                    },
                    "alternative": {
                        "border": {
                            "color": "var(--wp--preset--color--bnti-premier-dark)",
                            "radius": "8px",
                            "style": "solid",
                            "width": "1px"
                        },
                        "color": {
                            "background": "var(--wp--preset--color--bnti-white)",
                            "text": "var(--wp--preset--color--bnti-premier-dark)"
                        },
                        "shadow": "none",
                        "spacing": {
                            "padding": {
                                "top": "11px",
                                "right": "23px",
                                "bottom": "11px",
                                "left": "23px"
                            }
                        },
                        ":hover": {
                            "color": {
                                "gradient": "var(--wp--preset--gradient--bnti-premier)",
                                "text": "var(--wp--preset--color--bnti-white)"
                            }
                        }
                    },
                    "outline": {
                        "border": {
                            "color": "currentColor",
                            "radius": "8px",
                            "style": "solid",
                            "width": "1px"
                        },
                        "color": {
                            "background": "transparent",
                            "text": "var(--wp--preset--color--bnti-premier)"
                        },
                        "spacing": {
                            "padding": {
                                "top": "11px",
                                "right": "23px",
                                "bottom": "11px",
                                "left": "23px"
                            }
                        },
                        ":hover": {
                            "color": {
                                "background": "transparent",
                                "text": "var(--wp--preset--color--bnti-premier)"
                            }
                        }
                    }
                }
            },
            "core/buttons": {
                "spacing": {
                    "blockGap": "16px"
                }
            },
            "core/code": {
                "color": {
                    "background": "var(--wp--preset--color--bnti-neutral-lightest)",
                    "text": "var(--wp--preset--color--bnti-neutral-darkest)"
