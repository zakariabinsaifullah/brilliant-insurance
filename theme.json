                }
            },
            "core/comment-reply-link": {
                "elements": {
                    "link": {
                        "color": {
                            "text": "var(--wp--preset--color--bnti-ink)"
                        }
                    }
                },
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--bnti-small)"
                }
            },
            "core/comments-pagination": {
                "spacing": {
                    "margin": {
                        "bottom": "var(--wp--preset--spacing--bnti-40)",
                        "top": "var(--wp--preset--spacing--bnti-40)"
                    }
                },
                "typography": {
